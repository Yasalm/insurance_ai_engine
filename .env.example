# URL of the backend API server
API_SERVER_URL=https://your-default-api-url.com/v1
# Alternative variable for backend URL (API_SERVER_URL takes precedence)
BACKEND_URL=https://your-default-api-url.com/v1

# OCR Model URLs (derived from model names in src/config/models.yaml)
# Model names are converted: "nanonets/Nanonets-OCR2-3B" -> "NANONETS_NANONETS_OCR2_3B_URL"
NANONETS_NANONETS_OCR2_3B_URL=https://your-default-api-url.com/v1

NANONETS_NANONETS_OCR2_3B_URL=http://localhost:8000/v1 # or this, if you running in server and the client is calling the backend for model related stuff
REDNOTE_HILAB_DOTS_OCR_URL=https://your-default-api-url.com/v1


# Model URLs
# Generic fallback URL for models if specific one not found
MODEL_URL=//your-default-api-url.com/v1
